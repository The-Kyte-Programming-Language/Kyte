{
  "name": "kyte-lang",
  "displayName": "Kyte Language",
  "description": "Official language support for Kyte — syntax highlighting, real-time diagnostics, hover docs, code completion, go-to-definition, find references, rename, and signature help via the built-in LSP server.",
  "version": "0.1.0",
  "publisher": "kyte",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Kyte-Programming-Language/kyte"
  },
  "keywords": ["kyte", "language", "lsp", "anchor", "vault", "systems-programming"],
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kyte",
        "aliases": ["Kyte", "kyte"],
        "extensions": [".ky"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kyte",
        "scopeName": "source.kyte",
        "path": "./syntaxes/kyte.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kyte.restartServer",
        "title": "Kyte: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Kyte",
      "properties": {
        "kyte.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `kyte` binary used as the LSP server. Leave empty to auto-detect from the workspace `target/` directory or system `PATH`."
        },
        "kyte.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "LSP message tracing level for debugging the language server connection."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
