{
  "name": "Kyte",
  "scopeName": "source.kyte",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#anchors" },
    { "include": "#imports" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kyte",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kyte",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kyte",
              "match": "\\\\[nrt\\\\\"0]"
            }
          ]
        }
      ]
    },

    "fstrings": {
      "patterns": [
        {
          "name": "string.interpolated.kyte",
          "begin": "f\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.kyte" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.kyte" }
          },
          "patterns": [
            {
              "name": "meta.interpolation.kyte",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.kyte" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.kyte" }
              },
              "patterns": [
                { "include": "#keywords" },
                { "include": "#types" },
                { "include": "#functions" },
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#operators" },
                { "include": "#variables" }
              ]
            },
            {
              "name": "constant.character.escape.kyte",
              "match": "\\\\[nrt\\\\\"0]"
            }
          ]
        }
      ]
    },

    "anchors": {
      "patterns": [
        {
          "comment": "@name(event(type)) — 이벤트 앵커",
          "name": "meta.anchor.kyte",
          "match": "(@[a-zA-Z_]\\w*)\\s*(\\()\\s*(event)\\s*(\\()([a-zA-Z_]\\w*)(\\))(\\))",
          "captures": {
            "1": { "name": "entity.name.tag.anchor.kyte" },
            "2": { "name": "punctuation.definition.anchor.kyte" },
            "3": { "name": "constant.language.anchor-kind.kyte" },
            "4": { "name": "punctuation.definition.anchor.kyte" },
            "5": { "name": "constant.language.anchor-event.kyte" },
            "6": { "name": "punctuation.definition.anchor.kyte" },
            "7": { "name": "punctuation.definition.anchor.kyte" }
          }
        },
        {
          "comment": "@name(main|plain|thread)",
          "name": "meta.anchor.kyte",
          "match": "(@[a-zA-Z_]\\w*)\\s*(\\()\\s*(main|plain|thread)(\\))",
          "captures": {
            "1": { "name": "entity.name.tag.anchor.kyte" },
            "2": { "name": "punctuation.definition.anchor.kyte" },
            "3": { "name": "constant.language.anchor-kind.kyte" },
            "4": { "name": "punctuation.definition.anchor.kyte" }
          }
        },
        {
          "comment": "인식 못한 @형태 — 폴백",
          "name": "entity.name.tag.anchor.kyte",
          "match": "@[a-zA-Z_]\\w*"
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "name": "meta.import.kyte",
          "begin": "\\bimport\\b",
          "beginCaptures": {
            "0": { "name": "keyword.control.import.kyte" }
          },
          "end": ";",
          "patterns": [
            {
              "name": "string.quoted.double.kyte",
              "match": "\"[^\"]+\""
            },
            {
              "name": "entity.name.namespace.kyte",
              "match": "\\b[a-zA-Z_]\\w*(?:\\.[a-zA-Z_]\\w*)*\\b"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.kyte",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.kyte",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "anchor 흐름 제어 — Kill / Exit",
          "name": "keyword.control.anchor.kyte",
          "match": "\\b(Kill|Exit)\\b"
        },
        {
          "comment": "일반 흐름 제어",
          "name": "keyword.control.kyte",
          "match": "\\b(if|else|for|in|loop|while|break|return|yield|match|catch)\\b"
        },
        {
          "comment": "힙 할당 한정자",
          "name": "storage.modifier.kyte",
          "match": "\\bVault\\b"
        },
        {
          "comment": "선언 키워드",
          "name": "keyword.declaration.kyte",
          "match": "\\b(fn|struct|enum|trait|impl|mod|const)\\b"
        },
        {
          "comment": "타입 변환",
          "name": "keyword.operator.cast.kyte",
          "match": "\\bas\\b"
        },
        {
          "comment": "내장 함수형 키워드",
          "name": "keyword.other.builtin.kyte",
          "match": "\\b(print|assert|emit|auto)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "부호 있는 / 없는 정수 타입",
          "name": "storage.type.numeric.kyte",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64)\\b"
        },
        {
          "comment": "기본 원시 타입",
          "name": "storage.type.primitive.kyte",
          "match": "\\b(int|float|string|bool)\\b"
        },
        {
          "comment": "사용자 정의 타입 (PascalCase)",
          "name": "entity.name.type.kyte",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "comment": "module.method() — 모듈 메서드 호출",
          "name": "meta.method-call.kyte",
          "match": "\\b([a-zA-Z_]\\w*)(\\.)(([a-zA-Z_]\\w*)\\s*(?=\\())",
          "captures": {
            "1": { "name": "variable.other.module.kyte" },
            "2": { "name": "punctuation.accessor.kyte" },
            "4": { "name": "entity.name.function.kyte" }
          }
        },
        {
          "comment": "module.field — 필드 접근",
          "name": "meta.member-access.kyte",
          "match": "\\b([a-zA-Z_]\\w*)(\\.)(([a-zA-Z_]\\w*))",
          "captures": {
            "1": { "name": "variable.other.module.kyte" },
            "2": { "name": "punctuation.accessor.kyte" },
            "4": { "name": "variable.other.member.kyte" }
          }
        },
        {
          "comment": "일반 함수 호출",
          "name": "entity.name.function.kyte",
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"
        },
        {
          "comment": "구조체 초기화 / 접근",
          "name": "entity.name.type.struct.kyte",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(?=\\{|\\.)"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "comment": "암묵적 이벤트 페이로드 변수",
          "name": "variable.language.payload.kyte",
          "match": "\\b_payload\\b"
        },
        {
          "comment": "타입 선언 직후의 변수 이름",
          "name": "variable.other.definition.kyte",
          "match": "(?<=\\b(?:int|float|string|bool|i8|i16|i32|i64|u8|u16|u32|u64|[A-Z][a-zA-Z0-9_]*)\\s+)([a-zA-Z_]\\w*)\\b"
        },
        {
          "comment": "_ 접두사 변수 (미사용 억제)",
          "name": "variable.other.unused.kyte",
          "match": "\\b_[a-zA-Z0-9_]+\\b"
        },
        {
          "name": "variable.other.kyte",
          "match": "\\b[a-z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kyte",
          "match": "(->|\\.\\.|&&|\\|\\||[+\\-*/%]=?|[<>!=]=?|!)"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.kyte",
          "match": "[\\[\\]{}(),;]"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kyte",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "앵커 종류 식별자 (독립 토큰으로 나타날 때)",
          "name": "constant.language.anchor-kind.kyte",
          "match": "\\b(main|thread|event|plain)\\b"
        }
      ]
    }
  }
}
