fn classify(int n) -> int {
    if n > 0 {
        return 1;
    } else if n < 0 {
        return -1;
    } else {
        return 0;
    }
    return 0;
}

@main(main) {
    print(classify(5));
    print(classify(-3));
    print(classify(0));

    int x = 10;
    if x > 5 {
        print(1);
    } else {
        print(0);
    }
    if x < 5 {
        print(1);
    } else {
        print(0);
    }
}
