fn factorial(int n) -> int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fib(int n) -> int {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

@main(main) {
    print(factorial(0));
    print(factorial(1));
    print(factorial(5));
    print(factorial(10));
    print(fib(0));
    print(fib(1));
    print(fib(10));
}
