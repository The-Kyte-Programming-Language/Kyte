struct Point {
    int x;
    int y;
}

struct Rect {
    int w;
    int h;
}

fn area(Rect r) -> int {
    return r.w * r.h;
}

@main(main) {
    Point p = Point { x: 3, y: 4 };
    print(p.x);
    print(p.y);

    Rect r = Rect { w: 5, h: 10 };
    print(area(r));

    p.x = 100;
    print(p.x);
}
