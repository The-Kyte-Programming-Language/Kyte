fn fizzbuzz(int n) -> int {
    if n % 15 == 0 {
        return 3;
    }
    if n % 3 == 0 {
        return 1;
    }
    if n % 5 == 0 {
        return 2;
    }
    return 0;
}

@main(main) {
    print(fizzbuzz(1));
    print(fizzbuzz(3));
    print(fizzbuzz(5));
    print(fizzbuzz(15));
    print(fizzbuzz(30));
}
