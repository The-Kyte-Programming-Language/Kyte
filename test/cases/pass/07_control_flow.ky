// while loop: count from 0 to 9 — uses while, can't value-test
#test(success)
fn while_count() -> int {
    int i = 0;
    while (i < 10) {
        i = i + 1;
    }
    return i;
}

// for loop: sum 0..5 — uses for loop, can't value-test
#test(success)
fn for_sum() -> int {
    int total = 0;
    for i in 0..5 {
        total = total + i;
    }
    return total;
}

// nested if/else — pure if/else, can value-test
#test(success, 2)
fn if_else_chain() -> int {
    int x = 5;
    if x > 10 {
        return 1;
    } else {
        if x > 3 {
            return 2;
        } else {
            return 3;
        }
    }
    return 0;
}

// early return via while — uses while, can't value-test
#test(success)
fn early_return() -> int {
    int i = 0;
    while (i < 100) {
        if i == 1 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// for loop with break — uses for + break, can't value-test
#test(success)
fn for_break() -> int {
    int result = 0;
    for i in 0..10 {
        if i == 3 {
            result = i;
            break;
        }
    }
    return result;
}

// boolean logic — pure expressions, value-testable
#test(success, true)
fn bool_logic() -> bool {
    bool a = true;
    bool b = false;
    return a && !b;
}

// compound assign — CompoundAssign not in eval_stmt, can't value-test
#test(success)
fn compound_assign() -> int {
    int x = 10;
    x += 5;
    return x;
}

#test(success)
fn compound_sub() -> int {
    int x = 10;
    x -= 5;
    return x;
}

#test(success)
fn compound_mul() -> int {
    int x = 10;
    x *= 5;
    return x;
}

// simple if with no else — parse+analyze only
#test(success)
fn if_no_else() -> int {
    int x = 5;
    if x > 0 {
        x = 1;
    }
    return x;
}

// else if chain
#test(success, 3)
fn else_if_chain() -> int {
    int x = 3;
    if x == 1 {
        return 1;
    } else if x == 2 {
        return 2;
    } else {
        return 3;
    }
    return 0;
}

@main(main) {
    print("control flow tests");
}
