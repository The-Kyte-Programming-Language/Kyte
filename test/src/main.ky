@main(main) {
    Vault int virus_a = 1;
    Vault int virus_b = 2;
    Vault int virus_c = 3;

    print("--- Virus Injected: Level 2 ---");

    @doom_anchor() {
        // 이미 free된 Vault 메모리에 억지로 값 쓰기 시도
        virus_a = virus_a + virus_b;
        virus_b = virus_b + virus_c;
        virus_c = virus_a * virus_b;

        print(f"Chaos Level: {virus_c}");

        // 런타임 스택이 터질 때까지 Kill 난사
        Kill "Total Annihilation";
    }

    // 타입 에러 피하기 위한 무한 루프
    int stay_alive = 1;
    while (stay_alive == 1) {
        // 앵커가 실행될 틈을 주기 위해 메시지 출력
        print("Main is trapped in purgatory... waiting for chaos...");
    }
}